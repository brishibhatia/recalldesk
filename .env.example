# Demo runs without provider keys. Never deploy a demo with live keys.
APP_MODE=demo
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://recalldesk:local_demo_only@localhost:55432/recalldesk
# Required in live mode: at least 32 random characters; never expose NEXT_PUBLIC secrets.
BETTER_AUTH_SECRET=
# Provision merchant with npm run merchant:create; signup is disabled over HTTP.
MERCHANT_NAME=
MERCHANT_EMAIL=
MERCHANT_PASSWORD=
MERCHANT_PAYMENT_ADDRESS=
# Single merchant pilot: UUID returned by merchant:create. No shared multi-merchant key mapping.
LIVE_MERCHANT_ID=
TATUM_API_KEY=
TATUM_SUI_GRPC_ENDPOINT=sui-mainnet-grpc.gateway.tatum.io:443
SUI_NETWORK=mainnet
MEMWAL_ACCOUNT_ID=
MEMWAL_OWNER_ADDRESS=
MEMWAL_DELEGATE_KEY=
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=recalldesk-live-v1
# Mainnet writes require explicit operator opt-in. Account ownership is verified by SDK account reader.
ALLOW_MAINNET_WRITES=false
# pilot:setup enables this read-only local verification guard, shared by UI and CLI.
LOCAL_PILOT_VERIFICATION=false
# Set only after reviewing account dashboards; model metadata does not prove billing eligibility.
PILOT_FREE_TIER_CONFIRMED=false
PILOT_CREDENTIALS_ROTATED=false
# Optional separately authorized repair allowance; requires a private manifest bound to the original ledger.
# Setting a name alone never grants requests. Original history stays unchanged.
LLM_VERIFICATION_GRANT=
LLM_PROVIDER=gemini
# Documented free-tier candidate; verify access and the project's free-tier status before inference.
LLM_MODEL=gemini-3.8-flash
# Application backoff: 0-2 retries; SDK retries stay disabled. Every retry counts against pilot allowance.
LLM_MAX_RETRIES=2
GEMINI_API_KEY=
# To use OpenAI instead, set LLM_PROVIDER=openai and a supported LLM_MODEL; only that provider is initialized.
OPENAI_API_KEY=
# Optional authenticated scheduler; standalone worker needs no HTTP token.
WORKER_TOKEN=
# Opt-in read checks; use a real transaction associated with a configured order.
LIVE_TEST_DIGEST=
