{
  "name": "recalldesk",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "tsx scripts/accessibility.ts",
    "demo:record": "tsx scripts/record-demo.ts",
    "blog:build": "node scripts/build-blog.mjs",
    "db:local": "tsx --env-file-if-exists=.env.local scripts/local-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "worker:resume": "tsx --env-file-if-exists=.env.local scripts/resume-job.ts",
    "evaluate": "tsx --env-file-if-exists=.env.local scripts/evaluate.ts",
    "evaluate:live": "tsx --env-file-if-exists=.env.local scripts/evaluate-live.ts",
    "recall:client": "tsx --env-file-if-exists=.env.local scripts/recall-client.ts",
    "payments:smoke": "tsx --env-file-if-exists=.env.local scripts/payment-smoke.ts",
    "demo:reset": "tsx --env-file-if-exists=.env.local scripts/reset-demo.ts",
    "integrations:check": "tsx --env-file-if-exists=.env.local scripts/check-integrations.ts",
    "mainnet:seed": "tsx --env-file-if-exists=.env.local scripts/mainnet-seed.ts",
    "merchant:create": "tsx --env-file-if-exists=.env.local scripts/create-merchant.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "pilot:setup": "tsx scripts/pilot-setup.ts",
    "pilot:run": "tsx scripts/pilot-run.ts",
    "llm:smoke": "tsx --env-file-if-exists=.env.local scripts/llm-smoke.ts",
    "pilot:read-check": "tsx --env-file-if-exists=.env.local scripts/pilot-read-check.ts",
    "walrus:diagnose": "tsx --env-file-if-exists=.env.local scripts/diagnose-walrus.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@google/genai": "3.0.0",
    "@grpc/grpc-js": "1.14.7",
    "@mysten-incubation/memwal": "0.1.13",
    "@mysten/sui": "2.39.0",
    "@protobuf-ts/grpc-transport": "2.11.1",
    "better-auth": "1.7.17",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "openai": "7.51.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
